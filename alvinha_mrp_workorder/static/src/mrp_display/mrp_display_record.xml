<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alvinha_mrp_workorder.MrpDisplayRecord" t-inherit="mrp_workorder.MrpDisplayRecord" name="Alvinha MrpDisplayRecord" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'card-header ')]" position="inside">
            <div class="d-flex align-items-end gap-1" t-if="record.category_product_id">
                <span class="o_finished_product me-1" t-esc="record.category_product_id.display_name"/>
                     
            </div>
        </xpath>
        
    </t>


</templates>