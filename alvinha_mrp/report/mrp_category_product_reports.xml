<odoo>
    <record id="action_report_guide" model="ir.actions.report">
        <field name="name">Category Product (Guide)</field>
        <field name="model">mrp.category.product.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alvinha_mrp.guide_template</field>
        <field name="report_file">alvinha_mrp.guide_template</field>
        <field name="print_report_name">'Guia - %s - %s' % (object.mrp_category_id.name if object.mrp_category_id else '', object.date)</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="alvinha_base.paperformat_a4_portrait" />
    </record>
