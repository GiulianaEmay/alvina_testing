<odoo>
    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">
            <field name="commitment_date" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            
             
        </field>
    </record>

     <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <field name="can_edit_lines" invisible="1" />
            </sheet>

             <field name="order_line"  position="attributes" >
                <attribute name="readonly">state == 'cancel' or locked or not can_edit_lines</attribute>        
            </field>
            
        </field>
    </record>
    
</odoo>