<odoo>
    <record id="discount_list" model="ir.ui.view">
        <field name="name">alvina.employee.discount.list</field>
        <field name="model">alvina.employee.discount</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state in ('expired', 'cancelled')">
                <field name="employee_id"/><field name="masked_dni"/>
                <field name="week_start"/><field name="config_id"/><field name="order_id"/>
                <field name="cashier_id"/><field name="confirmed_at"/>
                <field name="original_total"/><field name="amount" sum="Descontado"/>
                <field name="reversed_amount" sum="Revertido"/><field name="balance"/>
                <field name="state"/><field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="discount_form" model="ir.ui.view">
        <field name="name">alvina.employee.discount.form</field><field name="model">alvina.employee.discount</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet><group>
                <field name="operation"/><field name="employee_id"/><field name="masked_dni"/>
                <field name="order_id"/><field name="config_id"/><field name="session_id"/>
                <field name="cashier_id"/><field name="week_start"/><field name="confirmed_at"/>
                <field name="expires_at"/><field name="state"/><field name="original_total"/>
                <field name="amount"/><field name="reversed_amount"/><field name="balance"/>
                <field name="effective_rate"/><field name="currency_id"/><field name="fingerprint"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="discount_search" model="ir.ui.view">
        <field name="name">alvina.employee.discount.search</field><field name="model">alvina.employee.discount</field>
        <field name="arch" type="xml"><search>
            <field name="employee_id"/><field name="config_id"/><field name="week_start"/><field name="order_id"/>
            <filter name="consumed" string="Consumidos" domain="[('state','=','consumed')]"/>
            <filter name="reserved" string="Reservas vigentes" domain="[('state','=','reserved'),('expires_at','&gt;',datetime.datetime.now())]"/>
            <filter name="by_employee" string="Colaborador" context="{'group_by':'employee_id'}"/>
            <filter name="by_config" string="Sucursal" context="{'group_by':'config_id'}"/>
            <filter name="by_week" string="Semana" context="{'group_by':'week_start:day'}"/>
        </search></field>
    </record>
    <record id="discount_pivot" model="ir.ui.view">
        <field name="name">alvina.employee.discount.pivot</field><field name="model">alvina.employee.discount</field>
        <field name="arch" type="xml"><pivot string="Descuentos ALVIÑA"><field name="employee_id" type="row"/><field name="week_start" type="col" interval="day"/><field name="amount" type="measure"/><field name="reversed_amount" type="measure"/></pivot></field>
    </record>
    <record id="discount_action" model="ir.actions.act_window">
        <field name="name">Beneficio de colaboradores ALVIÑA</field><field name="res_model">alvina.employee.discount</field>
        <field name="view_mode">list,form,pivot</field><field name="context">{'search_default_consumed': 1}</field>
    </record>
    <record id="reversal_action" model="ir.actions.act_window">
        <field name="name">Reversiones ALVIÑA</field><field name="res_model">alvina.employee.discount.reversal</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="discount_menu" name="Descuentos ALVIÑA" parent="point_of_sale.menu_point_root" action="discount_action" groups="group_discount_manager" sequence="80"/>
    <menuitem id="reversal_menu" name="Reversiones ALVIÑA" parent="point_of_sale.menu_point_root" action="reversal_action" groups="group_discount_manager" sequence="81"/>
</odoo>
