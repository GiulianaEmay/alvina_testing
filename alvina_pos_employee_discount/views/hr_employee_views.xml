<odoo>
    <record id="hr_employee_form_alvina" model="ir.ui.view">
        <field name="name">hr.employee.form.alvina</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="alvina_discount_authorized" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
