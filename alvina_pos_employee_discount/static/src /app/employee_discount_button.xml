<templates xml:space="preserve">
    <t t-name="alvina.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.config.alvina_discount_enabled" class="alvina-benefit-button" t-att-class="buttonClass" t-on-click.stop="alvinaDiscount">
                <i class="fa fa-id-card me-2" aria-hidden="true"/>
                Descuento colaborador
            </button>
        </xpath>
    </t>
</templates>
