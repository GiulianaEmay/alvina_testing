<odoo>
    <record id="group_discount_manager" model="res.groups">
        <field name="name">ALVIÑA: Administrador del beneficio</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="discount_company_rule" model="ir.rule">
        <field name="name">ALVIÑA: compañías permitidas</field>
        <field name="model_id" ref="model_alvina_employee_discount"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="reversal_company_rule" model="ir.rule">
        <field name="name">ALVIÑA: reversiones de compañías permitidas</field>
        <field name="model_id" ref="model_alvina_employee_discount_reversal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
