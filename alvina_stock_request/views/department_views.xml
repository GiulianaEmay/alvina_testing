<odoo>
    <record id="department_list" model="ir.ui.view">
        <field name="name">alvina.stock.department.list</field>
        <field name="model">alvina.stock.department</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="warehouse_id"/><field name="picking_type_id"/><field name="source_location_id"/><field name="location_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field>
    </record>
    <record id="department_form" model="ir.ui.view">
        <field name="name">alvina.stock.department.form</field>
        <field name="model">alvina.stock.department</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="warehouse_id" options="{'no_create': True}"/><field name="picking_type_id" options="{'no_create': True}"/><field name="source_location_id"/><field name="location_id" options="{'no_create': True}"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_departments" model="ir.actions.act_window">
        <field name="name">Departamentos y rutas</field><field name="res_model">alvina.stock.department</field><field name="view_mode">list,form</field>
    </record>
</odoo>
