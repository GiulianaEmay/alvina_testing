<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="alvinha_point_of_sale.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <img  position="attributes" class="pos-receipt-logo" >
            <attribute name="style">display: none;</attribute>
        </img>
        <div class="pos-receipt-contact" position="replace">
            <div class="pos-receipt-contact">
                

                <div t-if="order.config.receipt_header" style="white-space:pre-line" t-esc="order.config.receipt_header" />
                <div t-if="order?.getCashierName()" class="cashier d-none">
                    <div>Served by: <t t-esc="order.getCashierName()" /></div>
                </div>
                <div t-if="order.tracking_number and order.config.displayTrackingNumber and !order.config.displayBigTrackingNumber">
                    <span class="tracking-number fs-1" t-esc="order.tracking_number" />
                </div>
            </div>

        </div> 

        <t t-if="order.company.country_id?.code === 'PE' and order.to_invoice" position="replace">
            <t t-if="order.company.country_id?.code === 'PE' and order.to_invoice">
                <div class="text-center fw-bold mt-2">
                    <div t-out="order.company.name" />
                </div>
            </t>
        </t>

    </t>
 
</templates>
