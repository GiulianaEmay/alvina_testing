<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']/div[@class='content-group mt16']" position="inside">
                <div class="row">
                    <label string="Boletas" for="pos_ballot_journal_id" class="col-lg-3 o_light_label"/>
                    <field name="pos_ballot_journal_id" domain="[('company_id', '=', company_id), ('type', '=', 'sale')]"  context="{'default_company_id': company_id, 'default_type': 'sale'}"/>

                </div>
                <div class="row">
                    <label string="N.C. Facturas" for="pos_credit_note_journal_id" class="col-lg-3 o_light_label"/>
                    <field name="pos_credit_note_journal_id" domain="[('company_id', '=', company_id), ('type', '=', 'sale')]"  context="{'default_company_id': company_id, 'default_type': 'sale'}"/>

                </div>
                <div class="row">
                    <label string="N.C. Boleta" for="pos_credit_note_ballot_journal_id" class="col-lg-3 o_light_label"/>
                    <field name="pos_credit_note_ballot_journal_id" domain="[('company_id', '=', company_id), ('type', '=', 'sale')]"  context="{'default_company_id': company_id, 'default_type': 'sale'}"/>

                </div>
            </xpath>

            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting  help="Agregar el horario de inicio del turno pm">
                    <field name="pos_pm_start_hour"/>
                </setting>
            </xpath>
            
        </field>
    </record>
</odoo>